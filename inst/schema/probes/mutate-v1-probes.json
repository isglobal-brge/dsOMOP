    "expect": "invalid",
    "instance": {
      "version": 1,
      "assign": [
        {
          "name": "x",
          "expr": {
            "fn": "eval",
            "code": "system('x')"
          }
        }
      ]
    }
  },
  {
    "id": "M03",
    "label": "unknown top-level field rejected",
    "schema": "mutate-v1",
    "expect": "invalid",
    "instance": {
      "version": 1,
      "assign": [
        {
          "name": "x",
          "expr": {
            "lit": 1
          }
        }
      ],
      "already_gated": true
    }
  },
  {
    "id": "M04",
    "label": "case_when with coalesce and typed literal",
    "schema": "mutate-v1",
    "expect": "valid",
    "instance": {
      "version": 1,
      "assign": [
        {
          "name": "grp",
          "expr": {
            "case_when": {
              "cases": [
                {
                  "when": {
                    "var": "age",
                    "op": "<",
                    "value": 18
                  },
                  "then": {
                    "lit": "child"
                  }
                }
              ],
              "else": {
                "coalesce": [
                  {
                    "col": "label"
                  },
                  {
                    "lit": "adult",
                    "as": "text"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  {
    "id": "M05",
