[
  {
    "id": "M01",
    "label": "mutation request with arithmetic, cut and ifelse over an assigned column",
    "schema": "mutate-v1",
    "expect": "valid",
    "instance": {
      "version": 1,
      "assign": [
        {
          "name": "pdc",
          "expr": {
            "op": "/",
            "args": [
              {
                "col": "covered"
              },
              {
                "col": "observed"
              }
            ]
          }
        },
        {
          "name": "band",
          "expr": {
            "cut": {
              "arg": {
                "col": "age"
              },
              "breaks": [
                0,
                18,
                65,
                120
              ]
            }
          }
        },
        {
          "name": "flag",
          "expr": {
            "ifelse": {
              "test": {
                "var": "pdc",
                "op": ">=",
                "value": 0.8
              },
              "yes": {
                "lit": 1
              },
              "no": {
                "lit": 0
              }
            }
          }
        }
      ]
    }
  },
  {
    "id": "M02",
    "label": "free-form expression rejected",
